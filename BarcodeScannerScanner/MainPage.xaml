<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:gv="clr-namespace:BarcodeScanner.Mobile;assembly=BarcodeScanner.Mobile.Maui"
             x:Class="BarcodeScannerScanner.MainPage">
   
    <Grid RowDefinitions="*,Auto">
        <!--<gv:CameraView x:Name="barcodeScanner" IsScanning="True" IsEnabled="True" IsVisible="True"
                       VibrationOnDetected="True" OnDetected="CameraView_OnDetected" ScanInterval="10" />-->

        <Grid x:Name="ScannerView"/>

        <Grid RowDefinitions="*,2*,3*" >

            <BoxView Grid.Row="0" BackgroundColor="#80000000"/>

            <Grid ColumnDefinitions="*,2*,*" Grid.Row="1">
                <BoxView BackgroundColor="#80000000"/>
                <Grid Grid.Column="1" >
                    <BoxView WidthRequest="4" HeightRequest="30" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="{StaticResource Primary}"/>
                    <BoxView WidthRequest="4" HeightRequest="30" HorizontalOptions="End" VerticalOptions="Start" BackgroundColor="{StaticResource Primary}"/>
                    <BoxView WidthRequest="4" HeightRequest="30" HorizontalOptions="Start" VerticalOptions="End" BackgroundColor="{StaticResource Primary}"/>
                    <BoxView WidthRequest="4" HeightRequest="30" HorizontalOptions="End" VerticalOptions="End" BackgroundColor="{StaticResource Primary}"/>

                    <BoxView WidthRequest="30" HeightRequest="4" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="{StaticResource Primary}"/>
                    <BoxView WidthRequest="30" HeightRequest="4"  HorizontalOptions="End" VerticalOptions="Start" BackgroundColor="{StaticResource Primary}"/>
                    <BoxView WidthRequest="30" HeightRequest="4"  HorizontalOptions="Start" VerticalOptions="End" BackgroundColor="{StaticResource Primary}"/>
                    <BoxView WidthRequest="30" HeightRequest="4"  HorizontalOptions="End" VerticalOptions="End" BackgroundColor="{StaticResource Primary}"/>

                </Grid>
                <Frame Grid.Column="1" BorderColor="Transparent" CornerRadius="8" HasShadow="False" BackgroundColor="Transparent" Padding="0" />

                <BoxView Grid.Column="2" BackgroundColor="#80000000"/>
            </Grid>
            <BoxView Grid.Row="2" BackgroundColor="#80000000"/>
        </Grid>

        <Label Text="Nothing To Display!" HorizontalTextAlignment="Center" Padding="10" x:Name="ScanningResult" Background="White" TextColor="Black" Grid.Row="1" FontSize="Medium"/>

    </Grid> 

</ContentPage>

